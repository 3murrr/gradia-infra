{
  "title": "Gradia Autoscaling",
  "uid": "gradia-autoscaling",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "ds",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Replicas per service",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kube_deployment_status_replicas{namespace=\"gradia\"}",
          "legendFormat": "{{deployment}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "lineInterpolation": "stepAfter"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "CPU usage (cores)",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"gradia\",pod=~\"auth-.*\",container=\"auth\"}[1m]))",
          "legendFormat": "auth"
        },
        {
          "refId": "B",
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"gradia\",pod=~\"results-.*\",container=\"results\"}[1m]))",
          "legendFormat": "results"
        },
        {
          "refId": "C",
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"gradia\",pod=~\"frontend-.*\",container=\"frontend\"}[1m]))",
          "legendFormat": "frontend"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "CPU % of request (HPA target = 50%)",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate(container_cpu_usage_seconds_total{namespace=\"gradia\",pod=~\"auth-.*\",container=\"auth\"}[1m])) / sum(kube_pod_container_resource_requests{namespace=\"gradia\",pod=~\"auth-.*\",container=\"auth\",resource=\"cpu\"})",
          "legendFormat": "auth"
        },
        {
          "refId": "B",
          "expr": "100 * sum(rate(container_cpu_usage_seconds_total{namespace=\"gradia\",pod=~\"results-.*\",container=\"results\"}[1m])) / sum(kube_pod_container_resource_requests{namespace=\"gradia\",pod=~\"results-.*\",container=\"results\",resource=\"cpu\"})",
          "legendFormat": "results"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 50
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Memory (working set)",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(container_memory_working_set_bytes{namespace=\"gradia\",pod=~\"auth-.*\",container=\"auth\"})",
          "legendFormat": "auth"
        },
        {
          "refId": "B",
          "expr": "sum(container_memory_working_set_bytes{namespace=\"gradia\",pod=~\"results-.*\",container=\"results\"})",
          "legendFormat": "results"
        },
        {
          "refId": "C",
          "expr": "sum(container_memory_working_set_bytes{namespace=\"gradia\",pod=~\"frontend-.*\",container=\"frontend\"})",
          "legendFormat": "frontend"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    }
  ]
}